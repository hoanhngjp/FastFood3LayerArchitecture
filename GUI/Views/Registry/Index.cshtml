@{
    Layout = "_Layout";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đăng ký - Foodie</title>
    <link rel="stylesheet" href="/css/style.css">
    <!-- Ionicons -->
    <script type="module" src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.js"></script>
</head>
<body class="page-register">

    <!-- Register Form -->
    <main class="section">
        <h2 class="section-title">Đăng ký tài khoản</h2>

        <form class="form-container" id="registerForm">
            <div id="alert-message-signup" style="display: none; color: red; margin-bottom: 10px;"></div>
            <input type="text" name="fullName" id="fullName"class="input-field" placeholder="Họ và tên" required>
            <input type="email" name="email" id="email" class="input-field" placeholder="Email" required>
            <input type="password" name="password" id="password" class="input-field" placeholder="Mật khẩu" required>
            <input type="password" name="confirmPassword" id="confirmPassword" class="input-field" placeholder="Xác nhận mật khẩu" required>
            <!--   <label for="dob" style="font-size:0.9rem; color:#555; margin-top:0.5rem;">Ngày sinh</label>
            <input type="date" name="dob" id="dob" class="input-field" required>

            <label for="avatar" style="font-size:0.9rem; color:#555; margin-top:0.5rem;">Ảnh đại diện (tùy chọn)</label>
            <input type="url" name="avatar" id="avatar" class="input-field" placeholder="Link ảnh đại diện">  -->

            <!-- Submit -->
            <button type="submit" class="btn">Đăng ký</button>
        </form>

        <p class="register-footer-text">
            Đã có tài khoản? <a href="@Url.Action("Login", "Home")">Đăng nhập</a>
        </p>
    </main>


    <script type="module" src="/js/authService.js"></script>
    <script type="module" src="/js/signup.js"></script>
</body>
</html>
