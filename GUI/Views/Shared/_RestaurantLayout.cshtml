@{
    Layout = "_Layout";
}
<!-- Nạp Bootstrap và CSS riêng -->

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="/css/restaurant-style.css" />

<div id="wrapper" class="d-flex">

    <!-- Sidebar -->
    <nav id="restaurant-sidebar" class="sidebar bg-dark text-white p-3">
        <button id="toggleButton" class="btn btn-outline-light mb-3 w-100">
            ☰ Menu
        </button>

        <div class="sidebar-content">
            <ul class="nav flex-column">
                <li class="nav-item mb-2">
                    <a class="nav-link text-white active" aria-current="page" href="~/Restaurant/Index">
                        Trang Chủ Nhà Hàng
                    </a>
                </li>
                <li class="nav-item mb-2">
                    <a class="nav-link text-white" href="~/Restaurant/Orders">
                        Quản Lý Đơn Hàng
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white" href="~/Restaurant/OrderDetail">
                        Chi Tiết Đơn Hàng (Test)
                    </a>
                </li>
            </ul>
        </div>
    </nav>

    <!-- Nội dung chính -->
    <div class="main-content flex-grow-1 p-4 bg-light">
        @RenderBody()
    </div>

</div>

<!-- Nạp Bootstrap JS + Script riêng -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const toggleButton = document.getElementById('toggleButton');
            const sidebar = document.getElementById('restaurant-sidebar');

            toggleButton.addEventListener('click', function () {
                sidebar.classList.toggle('collapsed');
            });
        });
    </script>
