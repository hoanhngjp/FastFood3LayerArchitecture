<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GUI</title>

    <!-- 🟦 Bootstrap CSS (thêm mới) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- 🟩 CSS cũ của bạn (đặt sau để ghi đè nếu cần) -->
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/ionicons@5.5.2/dist/css/ionicons.min.css">

    <style>
        /* Ẩn mũi tên caret */
        .dropdown-toggle::after {
            display: none;
        }
    </style>
</head>

<body>
    <header class="header" data-header>
        <div class="container d-flex justify-content-between align-items-center">
            <h1><a href="@Url.Action("Index", "Home")" class="logo text-decoration-none">Foodie</a></h1>

            <nav class="navbar" data-navbar>
                <ul class="navbar-list list-unstyled d-flex mb-0">
                    <li><a href="/#home" class="navbar-link px-3" data-nav-link>Home</a></li>
                    <li><a href="/#about" class="navbar-link px-3" data-nav-link>About</a></li>
                    <li><a href="/#food-menu" class="navbar-link px-3" data-nav-link>Shop</a></li>
                    <li><a href="/#contact" class="navbar-link px-3" data-nav-link>Contact</a></li>
                </ul>
            </nav>

            <div class="header-btn-group d-flex align-items-center gap-2 position-relative">

                <button class="btn btn-outline-primary" onclick="location.href='@Url.Action("Login", "Home")'">Login</button>
                <button class="btn btn-primary" onclick="location.href='@Url.Action("Registry", "Home")'">Registry</button>

                <button class="btn btn-outline-primary dropdown-toggle" type="button" id="userMenuToggle" data-bs-toggle="dropdown" aria-expanded="false">
                    ☰
                </button>
                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userMenuToggle">
                    <li><strong class="dropdown-item-text">John Doe</strong></li>
                    <li><small class="dropdown-item-text text-muted">john@example.com</small></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item" href="/Account/Index">Dashboard</a></li>
                    <li><a class="dropdown-item" href="/Account/Profile">Profile</a></li>
                    <li><a class="dropdown-item" href="/Account/OrderHistory">Order History</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item text-danger" href="/Home/Logout">Logout</a></li>
                </ul>

            </div>

        </div>
    </header>

    <div class="container mt-5">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer id="contact" class="footer mt-5">
        <div class="footer-top py-5" style="background-image: url('/images/footer-illustration.png')">
            <div class="container d-flex flex-wrap justify-content-between gap-4">

                <div class="footer-brand col-md-4">
                    <a href="" class="logo text-decoration-none fs-3 fw-bold">Foodie<span class="span">.</span></a>
                    <p class="footer-text mt-3">
                        Financial experts support or help you to find out which way you can raise your funds more.
                    </p>
                    <ul class="social-list list-unstyled d-flex gap-3 mt-3">
                        <li><a href="#" class="social-link"><ion-icon name="logo-facebook"></ion-icon></a></li>
                        <li><a href="#" class="social-link"><ion-icon name="logo-twitter"></ion-icon></a></li>
                        <li><a href="#" class="social-link"><ion-icon name="logo-instagram"></ion-icon></a></li>
                        <li><a href="#" class="social-link"><ion-icon name="logo-pinterest"></ion-icon></a></li>
                    </ul>
                </div>

                <ul class="footer-list list-unstyled col-md-3">
                    <li><p class="footer-list-title fw-bold">Contact Info</p></li>
                    <li><p class="footer-list-item">+91 9664128814</p></li>
                    <li><p class="footer-list-item">Info@Naveen24.com</p></li>
                    <li><address class="footer-list-item">147 Williamson P, Tamilnadu, Chennai</address></li>
                </ul>

                <ul class="footer-list list-unstyled col-md-3">
                    <li><p class="footer-list-title fw-bold">Opening Hours</p></li>
                    <li><p class="footer-list-item">Monday-Friday: 08:00-22:00</p></li>
                    <li><p class="footer-list-item">Tuesday 4PM: Till Mid Night</p></li>
                    <li><p class="footer-list-item">Saturday: 10:00-16:00</p></li>
                </ul>

            </div>
        </div>
    </footer>

    <!-- 🟨 Bootstrap JS Bundle (thêm mới) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- 🧩 Thư viện & script cũ -->
    <script src="/lib/jquery/dist/jquery.min.js"></script>
    <script src="/js/script.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
