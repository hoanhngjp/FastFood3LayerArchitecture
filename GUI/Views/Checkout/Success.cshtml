@{
    // Sử dụng Layout chính đã tích hợp Bootstrap
    Layout = "_Layout";
    ViewData["Title"] = "Đặt Hàng Thành Công";
}

<style>
    /* CSS Tùy chỉnh cho trang Success */
    .success-icon-container {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        background-color: #f0f0f0; /* Nền nhẹ */
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 2rem;
        border: 4px solid #ffc107; /* Viền màu chủ đạo */
    }

    .success-content {
        max-width: 600px;
        margin: 0 auto;
        padding: 30px;
        border-radius: 10px;
        background: #fff;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
    }
</style>

<div class="container my-5">
    <div class="success-content text-center">

        <div class="success-icon-container">
            <i class="bi bi-check-circle-fill text-warning" style="font-size: 5rem;"></i>
        </div>

        <h1 class="fw-bold mb-3 text-success">ĐẶT HÀNG THÀNH CÔNG!</h1>

        <p class="lead text-muted">
            Cảm ơn quý khách. Đơn hàng của bạn đã được tiếp nhận và sẽ được xử lý trong thời gian sớm nhất.
        </p>

        <hr class="my-4">

        <div class="row text-start small">
            <div class="col-md-6 mb-3">
                <p class="mb-1"><strong>Mã đơn hàng:</strong> <span class="fw-bold text-danger">#FDE12345</span></p>
                <p class="mb-1"><strong>Ngày đặt:</strong> 12/11/2025</p>
                <p class="mb-1"><strong>Email:</strong> cuong.nguyen@mail.com</p>
            </div>
            <div class="col-md-6 mb-3">
                <p class="mb-1"><strong>Tổng tiền:</strong> <span class="fw-bold fs-5 text-warning">1.050.000₫</span></p>
                <p class="mb-1"><strong>Thanh toán:</strong> Tiền mặt (COD)</p>
                <p class="mb-1"><strong>Địa chỉ giao:</strong> 130 Xô Viết Nghệ Tĩnh</p>
            </div>
        </div>

        <p class="mt-3 text-secondary">
            Chúng tôi đã gửi email xác nhận chi tiết đơn hàng đến hòm thư của bạn.
        </p>

        <div class="d-grid gap-2 d-md-block mt-4">
            <a href="/" class="btn btn-warning btn-lg fw-bold me-md-2 text-dark">
                <i class="bi bi-house-door-fill me-2"></i> Quay về Trang chủ
            </a>
            <a href="@Url.Action("Index", "Account")" class="btn btn-outline-secondary btn-lg">
                <i class="bi bi-list-check me-2"></i> Xem Lịch sử Đơn hàng
            </a>
        </div>
    </div>
</div>