@{
    Layout = "_Layout";
    ViewData["Title"] = "Thanh Toán Đơn Hàng";
}

<style>
    /* Style cho Card thanh toán VNPay cố định */
    .payment-fixed-card {
        border: 2px solid #007bff; /* Màu xanh VNPay */
        background-color: #f8faff;
        border-radius: 8px;
        padding: 15px;
    }

    .form-section-title {
        border-bottom: 2px solid #eee;
        padding-bottom: 10px;
        margin-bottom: 20px;
        color: #FF8800;
    }
    /* Sticky summary on desktop */
    media (min-width: 992px) {
        .checkout-summary-card

    {
        top: 100px;
        position: sticky;
    }

    }
</style>

<div class="container my-5">
    <div class="text-center mb-4">
        <h2 class="fw-bold text-warning"><i class="bi bi-wallet2 me-2"></i> Thanh Toán & Đặt Hàng</h2>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card shadow-sm p-4 h-100">

                <h5 class="form-section-title"><i class="bi bi-shop me-2"></i> 1. Chọn Nhà Hàng</h5>
                <div class="mb-4">
                    <label class="form-label text-muted small">Món ăn sẽ được đặt từ chi nhánh này:</label>
                    <select id="restaurant-select" class="form-select form-select-lg border-warning">
                        <option value="0" selected disabled>-- Đang tải danh sách nhà hàng... --</option>
                    </select>

                    <div id="restaurant-info-area" class="mt-3 collapse">
                        <div class="card card-body bg-light border-0 small">
                            <p class="mb-1"><i class="bi bi-geo-alt-fill text-danger me-2"></i> <span id="rest-address"></span></p>
                            <p class="mb-1"><i class="bi bi-telephone-fill text-success me-2"></i> <span id="rest-phone"></span></p>
                            <p class="mb-0"><i class="bi bi-clock-fill text-primary me-2"></i> <span id="rest-time"></span></p>
                        </div>
                    </div>
                </div>

                <h5 class="form-section-title"><i class="bi bi-geo-alt-fill me-2"></i> 2. Thông tin Giao hàng</h5>

                <div class="mb-3">
                    <label class="form-label fw-bold">Chọn địa chỉ đã lưu:</label>
                    <div class="input-group">
                        <select id="address-select" class="form-select">
                            <option value="new">-- Nhập địa chỉ mới --</option>
                        </select>
                        <button class="btn btn-outline-secondary" type="button" id="refresh-address-btn" title="Tải lại"><i class="bi bi-arrow-clockwise"></i></button>
                    </div>
                </div>

                <form id="customer-form" class="row g-3">
                    <div class="col-md-6">
                        <label for="ho-ten" class="form-label">Người nhận <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="ho-ten" required placeholder="Tên người nhận">
                    </div>
                    <div class="col-md-6">
                        <label for="dien-thoai" class="form-label">Điện thoại <span class="text-danger">*</span></label>
                        <input type="tel" class="form-control" id="dien-thoai" required placeholder="Số điện thoại">
                    </div>
                    <div class="col-12">
                        <label for="dia-chi" class="form-label">Địa chỉ chi tiết <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="dia-chi" required placeholder="Số nhà, tên đường, phường/xã...">
                    </div>
                </form>

                <h5 class="form-section-title mt-4"><i class="bi bi-credit-card-2-front-fill me-2"></i> 3. Thanh toán</h5>

                <div class="payment-fixed-card">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <h6 class="fw-bold text-primary mb-1">Thanh toán qua VNPAY</h6>
                            <small class="text-muted">ATM / Internet Banking / QR Code</small>
                        </div>
                        <img src="/images/Icon-VNPAY-QR.webp" alt="VNPay" style="height: 40px;">
                    </div>
                    <div class="alert alert-info mt-3 mb-0 small">
                        <i class="bi bi-info-circle-fill me-1"></i>
                        Bạn sẽ được chuyển hướng sang cổng thanh toán VNPAY an toàn sau khi bấm "Đặt hàng".
                    </div>
                </div>

                <button type="button" id="complete-checkout-btn" class="btn btn-warning fw-bold w-100 py-3 mt-4 text-dark fs-5 shadow-sm">
                    XÁC NHẬN & THANH TOÁN
                </button>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm bg-light p-4 checkout-summary-card">
                <h4 class="mb-3 border-bottom pb-2">Đơn hàng <span class="badge bg-warning text-dark rounded-pill float-end">0 món</span></h4>

                <ul class="list-group list-group-flush mb-3" id="summary-items-list">
                </ul>

                <ul class="list-group list-group-flush border-top pt-2">
                    <li class="list-group-item bg-light d-flex justify-content-between px-0">
                        <span>Tạm tính:</span>
                        <span id="summary-subtotal">0₫</span>
                    </li>
                    <li class="list-group-item bg-light d-flex justify-content-between px-0">
                        <span>Phí giao hàng:</span>
                        <span class="text-success" id="summary-shipping">Miễn phí</span>
                    </li>
                    <li class="list-group-item bg-light d-flex justify-content-between px-0 fw-bold fs-5 border-top mt-2 pt-2">
                        <span>Tổng cộng:</span>
                        <span class="text-danger" id="summary-total">0₫</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>
<script type="module" src="/js/pages/checkout.js"></script>
<script type="module" src="/js/services/cartService.js"></script>
<script type="module" src="/js/services/orderService.js"></script>