@{
    Layout = "_Layout";
    ViewData["Title"] = "Thanh Toán Đơn Hàng";
}

<style>
    /* CSS tùy chỉnh để làm nổi bật phương thức thanh toán được chọn */
    .payment-option {
        border: 2px solid #ddd;
        border-radius: 8px;
        padding: 10px;
        transition: all 0.2s;
        cursor: pointer;
    }

        .payment-option:has(input:checked) {
            border-color: #FF8800; /* Màu vàng cam của Foodie */
            background-color: #fffaf0;
        }
    /* Đảm bảo khung tóm tắt luôn nổi bật trên màn hình lớn */
    @@media (min-width: 992px) {
        .checkout-summary-card {
            top: 20px; /* Độ dính trên cùng */
        }
    }
</style>

<div class="container my-5">

    <div class="text-center mb-4">
        <h2 class="fw-bold text-warning"><i class="bi bi-cart-check me-2"></i> Xác nhận Thanh Toán</h2>
        <p class="text-muted">Vui lòng kiểm tra lại thông tin và xác nhận đặt hàng.</p>
    </div>

    <div class="row g-4">

        <div class="col-lg-8">
            <div class="card shadow-sm p-4 h-100">

                <h4 class="mb-3 border-bottom pb-2"><i class="bi bi-person-fill me-2"></i> Thông tin Khách hàng</h4>
                <form id="customer-form" class="row g-3">

                    <div class="col-md-6">
                        <label for="ho-ten" class="form-label">Họ tên <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="ho-ten" value="Dương Nguyễn Phú Cường" required>
                    </div>

                    <div class="col-md-6">
                        <label for="dien-thoai" class="form-label">Điện thoại <span class="text-danger">*</span></label>
                        <input type="tel" class="form-control" id="dien-thoai" value="0915659223" required>
                    </div>

                    <div class="col-12">
                        <label for="dia-chi" class="form-label">Địa chỉ giao hàng <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="dia-chi" value="130 Xô Viết Nghệ Tĩnh" required>
                    </div>

                    <div class="col-md-6">
                        <label for="email" class="form-label">Email</label>
                        <input type="email" class="form-control" id="email" placeholder="Nhập email (tùy chọn)">
                    </div>

                    <div class="col-md-6">
                        <label for="gioi-tinh" class="form-label">Giới tính</label>
                        <select id="gioi-tinh" class="form-select">
                            <option selected>Nam</option>
                            <option>Nữ</option>
                            <option>Khác</option>
                        </select>
                    </div>

                    <div class="col-12">
                        <label for="ghi-chu" class="form-label">Ghi chú cho đơn hàng</label>
                        <textarea class="form-control" id="ghi-chu" rows="3" placeholder="Ví dụ: Giao sau 5h chiều, không lấy hành..."></textarea>
                    </div>

                </form>

                <h4 class="mt-5 mb-3 border-bottom pb-2"><i class="bi bi-credit-card-fill me-2"></i> Hình thức Thanh toán</h4>
                <div id="payment-options">

                    <label class="payment-option mb-3 d-block" for="tien-mat">
                        <div class="d-flex align-items-center">
                            <input class="form-check-input me-3" type="radio" name="payment-method" id="tien-mat" value="tien-mat" checked>
                            <span class="fw-bold">Thanh toán Tiền mặt khi nhận hàng (COD)</span>
                            <i class="bi bi-cash-coin ms-auto fs-4 text-success"></i>
                        </div>
                    </label>

                    <label class="payment-option mb-3 d-block" for="vnpay">
                        <div class="d-flex align-items-center">
                            <input class="form-check-input me-3" type="radio" name="payment-method" id="vnpay" value="vnpay">
                            <span class="fw-bold">Thanh toán VN PAY / Chuyển khoản Ngân hàng</span>
                            <img src="/images/Icon-VNPAY-QR.webp" alt="VN Pay" style="width: 60px; height: auto;" class="ms-auto me-2">
                        </div>

                        <div id="vnpay-details" class="p-3 mt-3 border bg-white rounded-3 collapse">
                            <p class="fw-bold text-warning mb-2">Vui lòng chuyển khoản chính xác nội dung đơn hàng.</p>
                            <div class="row small g-2">
                                <div class="col-4 text-muted">Ngân hàng:</div>
                                <div class="col-8 fw-bold">BIDV</div>
                                <div class="col-4 text-muted">Số tài khoản:</div>
                                <div class="col-8 fw-bold text-primary">1234567890</div>
                                <div class="col-4 text-muted">Chủ tài khoản:</div>
                                <div class="col-8 fw-bold">FOODIE COMPANY</div>
                                <div class="col-4 text-muted">Nội dung:</div>
                                <div class="col-8 fw-bold text-danger">FOODIE [Mã đơn hàng]</div>
                            </div>
                        </div>
                    </label>

                </div>

                <button type="button" id="complete-checkout-btn" class="btn btn-warning fw-bold w-100 py-3 mt-4 text-dark fs-5">
                    <i class="bi bi-check2-circle me-2"></i> HOÀN TẤT ĐẶT HÀNG
                </button>

            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm bg-light p-4 sticky-top checkout-summary-card">

                <h4 class="mb-3 border-bottom pb-2">Tóm tắt Đơn hàng <span class="badge bg-secondary rounded-pill float-end">0 món</span></h4>

                <ul class="list-group list-group-flush">
                </ul>

                <form class="input-group my-3">
                    <input type="text" class="form-control" placeholder="Mã khuyến mãi" aria-label="Mã khuyến mãi">
                    <button class="btn btn-outline-secondary" type="button">Áp dụng</button>
                </form>

                <ul class="list-group list-group-flush border-top pt-2">
                    <li class="list-group-item bg-light d-flex justify-content-between px-0">
                        <span>Tạm tính:</span>
                        <span>0₫</span>
                    </li>
                    <li class="list-group-item bg-light d-flex justify-content-between px-0">
                        <span>Phí giao hàng:</span>
                        <span class="text-success">Miễn phí</span>
                    </li>
                    <li class="list-group-item bg-light d-flex justify-content-between px-0 fw-bold fs-5">
                        <span>Tổng thanh toán:</span>
                        <span class="text-danger">0₫</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

<script>
    // Logic ẩn/hiện chi tiết VNPay (giữ lại ở đây hoặc chuyển hẳn sang checkout.js)
    document.addEventListener('DOMContentLoaded', function () {
        const codRadio = document.getElementById('tien-mat');
        const vnpayRadio = document.getElementById('vnpay');
        const vnpayDetails = document.getElementById('vnpay-details');

        function toggleVnPayDetails() {
            if (vnpayRadio && vnpayRadio.checked) {
                vnpayDetails.classList.add('show');
            } else {
                vnpayDetails.classList.remove('show');
            }
        }

        if (codRadio) codRadio.addEventListener('change', toggleVnPayDetails);
        if (vnpayRadio) vnpayRadio.addEventListener('change', toggleVnPayDetails);

        // Gọi lần đầu để thiết lập trạng thái ban đầu (nếu COD đang chọn, nó sẽ ẩn)
        toggleVnPayDetails();
    });
</script>
<script type="module" src="/js/pages/checkout.js"></script>
<script type="module" src="/js/services/cartService.js"></script>
<script type="module" src="/js/services/orderService.js"></script>