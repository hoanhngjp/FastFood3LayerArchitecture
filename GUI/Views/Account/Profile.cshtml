@{
    ViewData["Title"] = "Thông tin cá nhân";
}
<link rel="stylesheet" href="/css/account-profile.css" asp-append-version="true" />
<div class="account-profile container">
    <h2>✏️ Chỉnh sửa Thông tin cá nhân</h2>

    <form class="account-form">
        <div class="form-group">
            <label for="name">Họ và Tên</label>
            <input type="text" id="name" value="Nguyễn Văn A" required>
        </div>

        <div class="form-group">
            <label for="email">Email</label>
            <input type="email" id="email" value="a.nguyen@example.com" disabled>
        </div>

        <div class="form-group">
            <label for="phone">Số điện thoại</label>
            <input type="tel" id="phone" value="090xxxxxxx">
        </div>

        <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
    </form>
</div>