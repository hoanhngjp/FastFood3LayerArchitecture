@{
    Layout = "_Layout";
    ViewData["Title"] = "Quản lý Tài khoản Cá nhân";
}

<style>
    .nav-pills .nav-link.active, .nav-pills .nav-link.active:hover {
        background-color: #FF8800 !important;
        color: white !important;
    }

    .nav-pills .nav-link {
        color: #343a40;
    }
    /* Thêm CSS cho Dashboard cards để phù hợp với màu cam */
    .card-light-orange {
        background-color: #fff9f0; /* Màu cam nhạt */
        border-color: #ffc107;
    }

    .card-dark-orange {
        background-color: #ffc107; /* Màu cam đậm */
        color: #343a40; /* Chữ đen/xám để tương phản */
    }

        .card-dark-orange .card-title {
            color: #343a40 !important;
        }

    .text-dark-orange {
        color: #FF8800 !important; /* Đảm bảo màu cam chính */
    }
</style>

<div class="container my-5">

    <h2 class="fw-bold mb-4 text-dark-orange"><i class="bi bi-person-lines-fill me-2"></i> Tài khoản của tôi</h2>
    <hr class="mt-0">

    <div class="row g-4">

        <div class="col-lg-3">
            <div class="card shadow-sm border-0">
                <div class="card-body p-0">
                    <ul class="nav nav-pills flex-column" id="accountTabs" role="tablist">

                        <li class="nav-item" role="presentation">
                            <button class="nav-link active w-100 text-start rounded-0" id="dashboard-tab" data-bs-toggle="pill" data-bs-target="#dashboard-pane" type="button" role="tab" aria-controls="dashboard-pane" aria-selected="true">
                                <i class="bi bi-speedometer2 me-2"></i> Tổng quan (Dashboard)
                            </button>
                        </li>

                        <li class="nav-item" role="presentation">
                            <button class="nav-link w-100 text-start rounded-0" id="orders-tab" data-bs-toggle="pill" data-bs-target="#orders-pane" type="button" role="tab" aria-controls="orders-pane" aria-selected="false">
                                <i class="bi bi-clock-history me-2"></i> Lịch sử Đơn hàng
                            </button>
                        </li>

                        <li class="nav-item" role="presentation">
                            <button class="nav-link w-100 text-start rounded-0" id="addresses-tab" data-bs-toggle="pill" data-bs-target="#addresses-pane" type="button" role="tab" aria-controls="addresses-pane" aria-selected="false">
                                <i class="bi bi-geo-alt-fill me-2"></i> Địa chỉ Giao hàng
                            </button>
                        </li>

                        <li class="nav-item" role="presentation">
                            <button class="nav-link w-100 text-start rounded-0" id="profile-tab" data-bs-toggle="pill" data-bs-target="#profile-pane" type="button" role="tab" aria-controls="profile-pane" aria-selected="false">
                                <i class="bi bi-person-vcard me-2"></i> Thông tin cá nhân
                            </button>
                        </li>

                        <li class="nav-item mt-3 px-3">
                            <button type="button" class="btn btn-outline-danger w-100" id="account-logout-btn">
                                <i class="bi bi-box-arrow-right me-2"></i> Đăng xuất
                            </button>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-lg-9">
            <div class="tab-content" id="accountTabsContent">

                <div class="tab-pane fade show active" id="dashboard-pane" role="tabpanel" aria-labelledby="dashboard-tab">
                    <div class="card shadow-sm p-4">
                        <h4 class="fw-bold border-bottom pb-2 mb-3 text-dark-orange"><i class="bi bi-graph-up-arrow me-2"></i> Tổng quan hoạt động</h4>

                        <div class="row g-3">
                            <div class="col-md-6 col-lg-4">
                                <div class="card card-light-orange shadow-sm">
                                    <div class="card-body">
                                        <h5 class="card-title"><i class="bi bi-bag-check-fill me-2"></i> Tổng đơn hàng</h5>
                                        @* Dữ liệu sẽ được điền vào thẻ p này *@
                                        <p class="card-text fs-2 fw-bold">0</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6 col-lg-4">
                                <div class="card card-dark-orange shadow-sm">
                                    <div class="card-body">
                                        <h5 class="card-title"><i class="bi bi-currency-dollar me-2"></i> Tổng chi tiêu</h5>
                                        @* Dữ liệu sẽ được điền vào thẻ p này *@
                                        <p class="card-text fs-2 fw-bold">0₫</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6 col-lg-4">
                                <div class="card card-light-orange shadow-sm">
                                    <div class="card-body">
                                        <h5 class="card-title"><i class="bi bi-star-fill me-2"></i> Điểm tích lũy</h5>
                                        @* Dữ liệu sẽ được điền vào thẻ p này *@
                                        <p class="card-text fs-2 fw-bold">0</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <h5 class="mt-4 mb-3 border-bottom pb-2 text-dark-orange">Đơn hàng gần đây</h5>
                        @* List này sẽ được JS điền dữ liệu *@
                        <ul class="list-group list-group-flush">
                            <li class="list-group-item">Đang tải đơn hàng gần đây...</li>
                        </ul>
                    </div>
                </div>

                <div class="tab-pane fade" id="orders-pane" role="tabpanel" aria-labelledby="orders-tab">
                    <div class="card shadow-sm p-4">
                        <h4 class="fw-bold border-bottom pb-2 mb-3 text-dark-orange"><i class="bi bi-list-columns-reverse me-2"></i> Lịch sử Đơn hàng</h4>
                        <p class="text-muted">Danh sách chi tiết đơn hàng đã đặt.</p>
                        <div class="table-responsive">
                            <table class="table table-striped table-hover align-middle">
                                <thead>
                                    <tr>
                                        <th>Mã Đơn hàng</th>
                                        <th>Ngày đặt</th>
                                        <th>Tổng tiền</th>
                                        <th>Trạng thái</th>
                                        <th>Chi tiết</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @* Dữ liệu sẽ được điền bởi addressManager.js *@
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="tab-pane fade" id="addresses-pane" role="tabpanel" aria-labelledby="addresses-tab">
                    <div class="card shadow-sm p-4">
                        <h4 class="fw-bold border-bottom pb-2 mb-3 text-dark-orange"><i class="bi bi-geo-alt me-2"></i> Địa chỉ Giao hàng của tôi</h4>

                        <div class="d-flex justify-content-between mb-3">
                            <p class="text-muted m-0">Quản lý các địa chỉ lưu trữ để đặt hàng nhanh hơn.</p>
                            <button class="btn btn-warning text-dark fw-bold" data-bs-toggle="modal" data-bs-target="#addAddressModal">
                                <i class="bi bi-plus-lg me-2"></i> Thêm địa chỉ mới
                            </button>
                        </div>

                        <div id="address-list-container">
                            @* Dữ liệu địa chỉ sẽ được điền bởi addressManager.js *@
                            <div class="text-center p-5"><span class="spinner-border text-warning" role="status"></span> Đang tải...</div>
                        </div>

                    </div>
                </div>


                <div class="tab-pane fade" id="profile-pane" role="tabpanel" aria-labelledby="profile-tab">
                    <div class="card shadow-sm p-4">
                        <h4 class="fw-bold border-bottom pb-2 mb-3 text-dark-orange"><i class="bi bi-info-circle me-2"></i> Cập nhật Thông tin cá nhân</h4>

                        <form class="row g-3" id="profile-update-form">
                            <div class="col-md-6">
                                <label for="inputName" class="form-label">Họ Tên (*)</label>
                                <input type="text" class="form-control" id="inputName" value="" required>
                            </div>
                            <div class="col-md-6">
                                <label for="inputEmail" class="form-label">Email (*)</label>
                                <input type="email" class="form-control" id="inputEmail" value="" disabled>
                            </div>
                            <div class="col-md-6">
                                <label for="inputPhone" class="form-label">Điện thoại (*)</label>
                                <input type="tel" class="form-control" id="inputPhone" value="" required>
                            </div>
                            <div class="col-md-6">
                                <label for="inputGender" class="form-label">Giới tính</label>
                                <select id="inputGender" class="form-select">
                                    <option value="Nam">Nam</option>
                                    <option value="Nữ">Nữ</option>
                                    <option value="Khác">Khác</option>
                                </select>
                            </div>

                            <h5 class="mt-4 mb-3 border-bottom pb-2 text-dark-orange">Đổi mật khẩu</h5>
                            <div class="col-md-4">
                                <label for="currentPassword" class="form-label">Mật khẩu Hiện tại</label>
                                <input type="password" class="form-control" id="currentPassword">
                            </div>
                            <div class="col-md-4">
                                <label for="newPassword" class="form-label">Mật khẩu Mới</label>
                                <input type="password" class="form-control" id="newPassword">
                            </div>
                            <div class="col-md-4">
                                <label for="confirmPassword" class="form-label">Xác nhận Mật khẩu Mới</label>
                                <input type="password" class="form-control" id="confirmPassword">
                            </div>

                            <div class="col-12 mt-4">
                                <button type="submit" class="btn btn-warning btn-lg text-dark fw-bold">
                                    <i class="bi bi-save me-2"></i> Lưu Thay Đổi
                                </button>
                            </div>
                        </form>
                    </div>
                </div>

            </div>
        </div>
    </div>

    @* Modal Thêm/Sửa Địa chỉ *@
    <div class="modal fade" id="addAddressModal" tabindex="-1" aria-labelledby="addAddressModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title text-dark-orange" id="addAddressModalLabel"><i class="bi bi-geo-alt me-2"></i> Thêm Địa chỉ Mới</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form id="add-address-form">
                    <div class="modal-body row g-3">
                        <input type="hidden" id="address-id-input" value="0">

                        <div class="col-md-6">
                            <label for="inputReceiverName" class="form-label">Tên người nhận (*)</label>
                            <input type="text" class="form-control" id="inputReceiverName" name="receiverName" required>
                        </div>
                        <div class="col-md-6">
                            <label for="inputReceiverPhone" class="form-label">Số điện thoại (*)</label>
                            <input type="tel" class="form-control" id="inputReceiverPhone" name="receiverPhone" required>
                        </div>

                        <div class="col-md-4">
                            <label for="inputCity" class="form-label">Tỉnh/Thành phố (*)</label>
                            <input type="text" class="form-control" id="inputCity" name="city" required>
                        </div>
                        <div class="col-md-4">
                            <label for="inputWard" class="form-label">Phường/Xã (*)</label>
                            <input type="text" class="form-control" id="inputWard" name="ward" required>
                        </div>

                        <div class="col-12">
                            <label for="inputDetailedAddress" class="form-label">Địa chỉ chi tiết (Số nhà, đường...)</label>
                            <input type="text" class="form-control" id="inputDetailedAddress" name="detailedAddress" required>
                        </div>

                        <div class="col-12">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="inputIsDefault" name="isDefault">
                                <label class="form-check-label" for="inputIsDefault">
                                    Đặt làm địa chỉ mặc định
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn btn-warning text-dark fw-bold" id="save-address-btn">
                            <i class="bi bi-plus-circle me-2"></i> Lưu Địa chỉ
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
</div>

<script type="module" src="/js/services/addressService.js"></script>
<script type="module" src="/js/addressManager.js"></script>
<script type="module" src="/js/authChecker.js"></script>