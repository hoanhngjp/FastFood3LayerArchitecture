@{
    Layout = "_Layout";
    ViewData["Title"] = "Quản lý Tài khoản Cá nhân";
}

<style>
    .nav-pills .nav-link.active, .nav-pills .nav-link.active:hover {
        background-color: #FF8800 !important;
        color: white !important;
    }

    .nav-pills .nav-link {
        color: #343a40;
    }
    /* Thêm CSS cho Dashboard cards */
    .card-light-orange {
        background-color: #fff9f0; /* Màu cam nhạt */
        border-color: #ffc107;
    }

    .card-dark-orange {
        background-color: #ffc107; /* Màu cam đậm */
        color: #343a40;
    }

        .card-dark-orange .card-title {
            color: #343a40 !important;
        }

    .text-dark-orange {
        color: #FF8800 !important;
    }
</style>

<div class="container my-5">

    <h2 class="fw-bold mb-4 text-dark-orange"><i class="bi bi-person-lines-fill me-2"></i> Tài khoản của tôi</h2>
    <hr class="mt-0">

    <div class="row g-4">

        <div class="col-lg-3">
            <div class="card shadow-sm border-0">
                <div class="card-body p-0">
                    <ul class="nav nav-pills flex-column" id="accountTabs" role="tablist">

                        <li class="nav-item" role="presentation">
                            <button class="nav-link active w-100 text-start rounded-0" id="dashboard-tab" data-bs-toggle="pill" data-bs-target="#dashboard-pane" type="button" role="tab" aria-controls="dashboard-pane" aria-selected="true">
                                <i class="bi bi-speedometer2 me-2"></i> Tổng quan (Dashboard)
                            </button>
                        </li>

                        <li class="nav-item" role="presentation">
                            <button class="nav-link w-100 text-start rounded-0" id="orders-tab" data-bs-toggle="pill" data-bs-target="#orders-pane" type="button" role="tab" aria-controls="orders-pane" aria-selected="false">
                                <i class="bi bi-clock-history me-2"></i> Lịch sử Đơn hàng
                            </button>
                        </li>

                        <li class="nav-item" role="presentation">
                            <button class="nav-link w-100 text-start rounded-0" id="addresses-tab" data-bs-toggle="pill" data-bs-target="#addresses-pane" type="button" role="tab" aria-controls="addresses-pane" aria-selected="false">
                                <i class="bi bi-geo-alt-fill me-2"></i> Địa chỉ Giao hàng
                            </button>
                        </li>

                        <li class="nav-item mt-3 px-3 pb-3">
                            <button type="button" class="btn btn-outline-danger w-100" id="account-logout-btn" onclick="import('/js/services/authService.js').then(m => m.logout().then(() => window.location.href='/'))">
                                <i class="bi bi-box-arrow-right me-2"></i> Đăng xuất
                            </button>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-lg-9">
            <div class="tab-content" id="accountTabsContent">

                <div class="tab-pane fade show active" id="dashboard-pane" role="tabpanel" aria-labelledby="dashboard-tab">
                    <div class="card shadow-sm p-4">
                        <h4 class="fw-bold border-bottom pb-2 mb-3 text-dark-orange"><i class="bi bi-graph-up-arrow me-2"></i> Tổng quan hoạt động</h4>

                        <div class="row g-3">
                            <div class="col-md-6 col-lg-4">
                                <div class="card card-light-orange shadow-sm h-100">
                                    <div class="card-body text-center">
                                        <h5 class="card-title"><i class="bi bi-bag-check-fill me-2"></i> Tổng đơn hàng</h5>
                                        <p class="card-text fs-2 fw-bold mb-0">0</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6 col-lg-4">
                                <div class="card card-dark-orange shadow-sm h-100">
                                    <div class="card-body text-center">
                                        <h5 class="card-title"><i class="bi bi-currency-dollar me-2"></i> Tổng chi tiêu</h5>
                                        <p class="card-text fs-2 fw-bold mb-0">0₫</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6 col-lg-4">
                                <div class="card card-light-orange shadow-sm h-100">
                                    <div class="card-body text-center">
                                        <h5 class="card-title"><i class="bi bi-star-fill me-2"></i> Điểm tích lũy</h5>
                                        <p class="card-text fs-2 fw-bold mb-0">0</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <h5 class="mt-4 mb-3 border-bottom pb-2 text-dark-orange">Đơn hàng gần đây</h5>
                        <ul class="list-group list-group-flush">
                            <li class="list-group-item text-center p-3 text-muted">
                                <div class="spinner-border spinner-border-sm text-warning" role="status"></div> Đang tải dữ liệu...
                            </li>
                        </ul>
                    </div>
                </div>

                <div class="tab-pane fade" id="orders-pane" role="tabpanel" aria-labelledby="orders-tab">
                    <div class="card shadow-sm p-4">
                        <h4 class="fw-bold border-bottom pb-2 mb-3 text-dark-orange">
                            <i class="bi bi-list-columns-reverse me-2"></i> Lịch sử Đơn hàng
                        </h4>
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Mã Đơn</th>
                                        <th>Ngày đặt</th>
                                        <th>Nhà hàng</th>
                                        <th>Tổng tiền</th>
                                        <th>Trạng thái</th>
                                        <th>Hành động</th>
                                    </tr>
                                </thead>
                                <tbody id="orders-table-body">
                                    <tr>
                                        <td colspan="6" class="text-center py-4">
                                            <div class="spinner-border text-warning" role="status"></div>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="modal fade" id="orderDetailModal" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-lg">
                        <div class="modal-content">
                            <div class="modal-header bg-light">
                                <h5 class="modal-title fw-bold" id="orderDetailTitle">Chi tiết đơn hàng #...</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <p><strong>Ngày đặt:</strong> <span id="modal-order-date">...</span></p>
                                        <p><strong>Trạng thái:</strong> <span id="modal-order-status">...</span></p>
                                    </div>
                                    <div class="col-md-6">
                                        <p><strong>Tổng tiền:</strong> <span id="modal-order-total" class="text-danger fw-bold fs-5">...</span></p>
                                    </div>
                                </div>

                                <h6 class="fw-bold border-bottom pb-2 mb-2">Danh sách món ăn</h6>
                                <table class="table table-sm table-bordered">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Tên món</th>
                                            <th class="text-center">Số lượng</th>
                                            <th class="text-end">Đơn giá</th>
                                            <th class="text-end">Thành tiền</th>
                                        </tr>
                                    </thead>
                                    <tbody id="modal-items-body">
                                    </tbody>
                                </table>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                            </div>
                        </div>
                    </div>
                </div>

                <script type="module" src="/js/pages/account.js"></script>
                <div class="tab-pane fade" id="addresses-pane" role="tabpanel" aria-labelledby="addresses-tab">
                    <div class="card shadow-sm p-4">
                        <h4 class="fw-bold border-bottom pb-2 mb-3 text-dark-orange"><i class="bi bi-geo-alt me-2"></i> Địa chỉ Giao hàng của tôi</h4>

                        <div class="d-flex justify-content-between mb-3">
                            <p class="text-muted m-0">Quản lý các địa chỉ lưu trữ để đặt hàng nhanh hơn.</p>
                            <button class="btn btn-warning text-dark fw-bold" data-bs-toggle="modal" data-bs-target="#addAddressModal">
                                <i class="bi bi-plus-lg me-2"></i> Thêm địa chỉ mới
                            </button>
                        </div>

                        <div id="address-list-container">
                            <div class="text-center p-5"><span class="spinner-border text-warning" role="status"></span> Đang tải...</div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    @* Modal Thêm/Sửa Địa chỉ *@
    <div class="modal fade" id="addAddressModal" tabindex="-1" aria-labelledby="addAddressModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title text-dark-orange" id="addAddressModalLabel"><i class="bi bi-geo-alt me-2"></i> Thêm Địa chỉ Mới</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form id="add-address-form">
                    <div class="modal-body row g-3">
                        <input type="hidden" id="address-id-input" value="0">

                        <div class="col-md-6">
                            <label for="inputReceiverName" class="form-label">Tên người nhận (*)</label>
                            <input type="text" class="form-control" id="inputReceiverName" name="receiverName" required>
                        </div>
                        <div class="col-md-6">
                            <label for="inputReceiverPhone" class="form-label">Số điện thoại (*)</label>
                            <input type="tel" class="form-control" id="inputReceiverPhone" name="receiverPhone" required>
                        </div>

                        <div class="col-12">
                            <label for="inputDetailedAddress" class="form-label">Địa chỉ chi tiết (Số nhà, đường...)</label>
                            <div class="input-group mb-1">
                                <input type="text" class="form-control" id="inputDetailedAddress" name="detailedAddress" required placeholder="Số nhà, tên đường, phường/xã...">
                                <button class="btn btn-outline-secondary" type="button" id="btn-get-location" title="Lấy vị trí hiện tại của bạn">
                                    <i class="bi bi-geo-alt-fill"></i> Định vị
                                </button>
                            </div>
                            <div id="location-status"></div>
                        </div>

                        <div class="col-12">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="inputIsDefault" name="isDefault">
                                <label class="form-check-label" for="inputIsDefault">
                                    Đặt làm địa chỉ mặc định
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn btn-warning text-dark fw-bold" id="save-address-btn">
                            <i class="bi bi-plus-circle me-2"></i> Lưu Địa chỉ
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script type="module" src="/js/pages/account.js"></script>
<script type="module" src="/js/services/addressService.js"></script>
<script type="module" src="/js/addressManager.js"></script>
<script type="module" src="/js/authChecker.js"></script>