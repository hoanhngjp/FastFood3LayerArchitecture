@{
    Layout = "_Layout";
    ViewData["Title"] = "Quản lý Tài khoản Cá nhân";
}

<style>
    /* CSS tùy chỉnh cho các thẻ tổng quan để sử dụng tông cam */
    .card-dark-orange {
        background-color: #FF8800; /* Cam Rực Rỡ */
        color: #fff;
    }

    .card-light-orange {
        background-color: #FFC107; /* Vàng Cam Sáng (Warning) */
        color: #212529; /* Chữ màu tối */
    }

    .text-dark-orange {
        color: #FF8800 !important; /* Màu chữ đậm */
    }
    /* Đảm bảo nav-link khi active có nền màu cam */
    .nav-pills .nav-link.active, .nav-pills .nav-link.active:hover {
        background-color: #FF8800 !important;
        color: white !important;
    }

    .nav-pills .nav-link {
        color: #343a40; /* Màu chữ bình thường */
    }
</style>

<div class="container my-5">

    <h2 class="fw-bold mb-4 text-dark-orange"><i class="bi bi-person-lines-fill me-2"></i> Tài khoản của tôi</h2>
    <hr class="mt-0">

    <div class="row g-4">

        <div class="col-lg-3">
            <div class="card shadow-sm border-0">
                <div class="card-body p-0">
                    <ul class="nav nav-pills flex-column" id="accountTabs" role="tablist">

                        <li class="nav-item" role="presentation">
                            <button class="nav-link active w-100 text-start rounded-0" id="dashboard-tab" data-bs-toggle="pill" data-bs-target="#dashboard-pane" type="button" role="tab" aria-controls="dashboard-pane" aria-selected="true">
                                <i class="bi bi-speedometer2 me-2"></i> Tổng quan (Dashboard)
                            </button>
                        </li>

                        <li class="nav-item" role="presentation">
                            <button class="nav-link w-100 text-start rounded-0" id="orders-tab" data-bs-toggle="pill" data-bs-target="#orders-pane" type="button" role="tab" aria-controls="orders-pane" aria-selected="false">
                                <i class="bi bi-clock-history me-2"></i> Lịch sử Đơn hàng
                            </button>
                        </li>

                        <li class="nav-item" role="presentation">
                            <button class="nav-link w-100 text-start rounded-0" id="profile-tab" data-bs-toggle="pill" data-bs-target="#profile-pane" type="button" role="tab" aria-controls="profile-pane" aria-selected="false">
                                <i class="bi bi-person-vcard me-2"></i> Thông tin cá nhân
                            </button>
                        </li>

                        <li class="nav-item mt-3 px-3">
                            <a href="/Home/Logout" class="btn btn-outline-danger w-100">
                                <i class="bi bi-box-arrow-right me-2"></i> Đăng xuất
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-lg-9">
            <div class="tab-content" id="accountTabsContent">

                <div class="tab-pane fade show active" id="dashboard-pane" role="tabpanel" aria-labelledby="dashboard-tab">
                    <div class="card shadow-sm p-4">
                        <h4 class="fw-bold border-bottom pb-2 mb-3 text-dark-orange"><i class="bi bi-graph-up-arrow me-2"></i> Tổng quan hoạt động</h4>

                        <div class="row g-3">
                            <div class="col-md-6 col-lg-4">
                                <div class="card card-light-orange shadow-sm">
                                    <div class="card-body">
                                        <h5 class="card-title"><i class="bi bi-bag-check-fill me-2"></i> Tổng đơn hàng</h5>
                                        <p class="card-text fs-2 fw-bold">12</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6 col-lg-4">
                                <div class="card card-dark-orange shadow-sm">
                                    <div class="card-body">
                                        <h5 class="card-title"><i class="bi bi-currency-dollar me-2"></i> Tổng chi tiêu</h5>
                                        <p class="card-text fs-2 fw-bold">4.5M₫</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6 col-lg-4">
                                <div class="card card-light-orange shadow-sm">
                                    <div class="card-body">
                                        <h5 class="card-title"><i class="bi bi-star-fill me-2"></i> Điểm tích lũy</h5>
                                        <p class="card-text fs-2 fw-bold">850</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <h5 class="mt-4 mb-3 border-bottom pb-2 text-dark-orange">Đơn hàng gần đây</h5>
                        <ul class="list-group list-group-flush">
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div><span class="fw-bold text-dark-orange">#ORD1234</span> - <span class="text-muted small">12/11/2025</span></div>
                                <span class="badge bg-success">Hoàn thành</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div><span class="fw-bold text-dark-orange">#ORD1235</span> - <span class="text-muted small">15/11/2025</span></div>
                                <span class="badge bg-warning text-dark">Đang giao</span>
                            </li>
                        </ul>
                    </div>
                </div>

                <div class="tab-pane fade" id="orders-pane" role="tabpanel" aria-labelledby="orders-tab">
                    <div class="card shadow-sm p-4">
                        <h4 class="fw-bold border-bottom pb-2 mb-3 text-dark-orange"><i class="bi bi-list-columns-reverse me-2"></i> Lịch sử Đơn hàng</h4>
                        <p class="text-muted">Danh sách chi tiết 12 đơn hàng đã đặt.</p>

                        <div class="table-responsive">
                            <table class="table table-striped table-hover align-middle">
                                <thead>
                                    <tr>
                                        <th>Mã Đơn hàng</th>
                                        <th>Ngày đặt</th>
                                        <th>Tổng tiền</th>
                                        <th>Trạng thái</th>
                                        <th>Chi tiết</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td class="fw-bold text-dark-orange">#ORD1234</td>
                                        <td>12/11/2025</td>
                                        <td class="text-danger fw-bold">550.000₫</td>
                                        <td><span class="badge bg-success">Hoàn thành</span></td>
                                        <td><a href="#" class="btn btn-sm btn-outline-warning">Xem</a></td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold text-dark-orange">#ORD1235</td>
                                        <td>15/11/2025</td>
                                        <td class="text-danger fw-bold">380.000₫</td>
                                        <td><span class="badge bg-warning text-dark">Đang giao</span></td>
                                        <td><a href="#" class="btn btn-sm btn-outline-warning">Xem</a></td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold text-dark-orange">#ORD1236</td>
                                        <td>20/11/2025</td>
                                        <td class="text-danger fw-bold">120.000₫</td>
                                        <td><span class="badge bg-secondary">Đã hủy</span></td>
                                        <td><a href="#" class="btn btn-sm btn-outline-warning">Xem</a></td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold text-dark-orange">#ORD1237</td>
                                        <td>22/11/2025</td>
                                        <td class="text-danger fw-bold">450.000₫</td>
                                        <td><span class="badge bg-danger">Thất bại</span></td>
                                        <td><a href="#" class="btn btn-sm btn-outline-warning">Xem</a></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="tab-pane fade" id="profile-pane" role="tabpanel" aria-labelledby="profile-tab">
                    <div class="card shadow-sm p-4">
                        <h4 class="fw-bold border-bottom pb-2 mb-3 text-dark-orange"><i class="bi bi-info-circle me-2"></i> Cập nhật Thông tin cá nhân</h4>

                        <form class="row g-3">
                            <div class="col-md-6">
                                <label for="inputName" class="form-label">Họ Tên (*)</label>
                                <input type="text" class="form-control" id="inputName" value="Dương Nguyễn" required>
                            </div>
                            <div class="col-md-6">
                                <label for="inputEmail" class="form-label">Email (*)</label>
                                <input type="email" class="form-control" id="inputEmail" value="duong.nguyen@foodie.com" disabled>
                            </div>
                            <div class="col-md-6">
                                <label for="inputPhone" class="form-label">Điện thoại (*)</label>
                                <input type="tel" class="form-control" id="inputPhone" value="0915659223" required>
                            </div>
                            <div class="col-md-6">
                                <label for="inputGender" class="form-label">Giới tính</label>
                                <select id="inputGender" class="form-select">
                                    <option selected>Nam</option>
                                    <option>Nữ</option>
                                </select>
                            </div>
                            <div class="col-12">
                                <label for="inputAddress" class="form-label">Địa chỉ Mặc định</label>
                                <textarea class="form-control" id="inputAddress" rows="2">130 Xô Viết Nghệ Tĩnh, Quận Bình Thạnh, TP.HCM</textarea>
                            </div>

                            <h5 class="mt-4 mb-3 border-bottom pb-2 text-dark-orange">Đổi mật khẩu</h5>
                            <div class="col-md-4">
                                <label for="currentPassword" class="form-label">Mật khẩu Hiện tại</label>
                                <input type="password" class="form-control" id="currentPassword">
                            </div>
                            <div class="col-md-4">
                                <label for="newPassword" class="form-label">Mật khẩu Mới</label>
                                <input type="password" class="form-control" id="newPassword">
                            </div>
                            <div class="col-md-4">
                                <label for="confirmPassword" class="form-label">Xác nhận Mật khẩu Mới</label>
                                <input type="password" class="form-control" id="confirmPassword">
                            </div>

                            <div class="col-12 mt-4">
                                <button type="submit" class="btn btn-warning btn-lg text-dark fw-bold">
                                    <i class="bi bi-save me-2"></i> Lưu Thay Đổi
                                </button>
                            </div>
                        </form>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>