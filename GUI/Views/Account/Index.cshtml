@{
    ViewData["Title"] = "Tổng quan Tài khoản";
}
<link rel="stylesheet" href="/css/account-profile.css" asp-append-version="true" />
<div class="account-dashboard container">
    <h2>👤 Chào mừng, Tên Khách hàng!</h2>
    <p>Quản lý thông tin cá nhân, xem lịch sử đơn hàng, và cập nhật bảo mật.</p>

    <div class="account-grid">
        <div class="account-nav-menu">
            <ul>
                <li class="active"><a asp-action="Index">Tổng quan</a></li>
                <li><a asp-action="Profile">Thông tin cá nhân</a></li>
                <li><a asp-action="OrderHistory">Lịch sử đơn hàng</a></li>
                <li><a asp-action="ChangePassword">Đổi mật khẩu</a></li>
                <li><a asp-controller="Login" asp-action="Logout">Đăng xuất</a></li>
            </ul>
        </div>

        <div class="account-content">
            <h3>Tổng quan nhanh</h3>
            <p><strong>Đơn hàng gần nhất:</strong> #20250012 - Đang giao hàng.</p>
            <p><strong>Địa chỉ giao hàng mặc định:</strong> 123 Đường A, Quận B, TP.HCM</p>
            <p><a asp-action="OrderHistory" class="btn btn-link">Xem tất cả đơn hàng &rarr;</a></p>
        </div>
    </div>
</div>