@{
        Layout = "_Layout";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đăng nhập - Foodie</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="page-login">

    <!-- Main login section -->
    <main class="section">
        <h2 class="section-title">Đăng nhập</h2>
        <form id="loginForm" class="form-container">
            <div id="alert-message" style="display: none; color: red; margin-bottom: 10px;"></div>
            <input type="email" name="email" id="email" placeholder="Email" class="input-field" required>
            <input type="password" name="password" id="password" placeholder="Mật khẩu" class="input-field" required>
            <button type="submit" id="login-button" class="btn">Đăng nhập</button>
        </form>
        <p class="login-footer-text">
            Chưa có tài khoản? <a href="@Url.Action("Registry", "Home")">Đăng ký</a>
        </p>
    </main>

    <script type="module" src="/js/authService.js"></script>
    <script type="module" src="/js/login.js"></script>
</body>
</html>
