@{
    ViewData["Title"] = "Quản lý Đơn hàng";
    Layout = "~/Views/Shared/_LayoutManager.cshtml";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Quản lý Đơn hàng</h1>

    <div class="card mb-4 shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center bg-white py-3">
            <div class="d-flex align-items-center gap-3">
                <div class="fw-bold fs-5">
                    <i class="fas fa-table me-1"></i> Danh sách đơn hàng
                </div>

                <select id="restaurant-selector" class="form-select form-select-sm shadow-sm border-secondary fw-bold" style="width: 250px;">
                    <option>Đang tải danh sách...</option>
                </select>
            </div>

            <div class="d-flex gap-2">
                <select id="select-status-filter" class="form-select form-select-sm shadow-sm border-primary" style="width: 180px;">
                    <option value="All">-- Tất cả trạng thái --</option>
                    <option value="Pending">Chờ xử lý</option>
                    <option value="Preparing">Đang chuẩn bị</option>
                    <option value="Confirmed">Đã xác nhận</option>
                    <option value="Delivering">Đang giao hàng</option>
                    <option value="Delivered">Đã giao hàng</option>
                    <option value="Completed">Hoàn thành</option>
                    <option value="Cancelled">Đã hủy</option>
                </select>
                <button class="btn btn-sm btn-outline-primary shadow-sm" id="btn-refresh" title="Tải lại">
                    <i class="bi bi-arrow-clockwise"></i>
                </button>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Mã đơn</th>
                            <th>Khách hàng</th>
                            <th>Thời gian</th>
                            <th>Tổng tiền</th>
                            <th>Trạng thái</th>
                            <th class="text-end pe-3">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody id="manager-orders-table">
                        <tr><td colspan="6" class="text-center py-5 text-muted">Đang tải dữ liệu...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="assignDroneModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title"><i class="bi bi-airplane-fill"></i> Chọn Drone Giao Hàng</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Chọn Drone đang rảnh:</label>
                    <select class="form-select" id="drone-select">
                        <option>Đang tải...</option>
                    </select>
                </div>
                <div class="alert alert-info small">
                    <i class="bi bi-info-circle"></i> Drone sẽ tự động bay đến nhà hàng để lấy món, sau đó giao đến khách hàng.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary fw-bold" id="btn-confirm-assign">
                    Giao hàng ngay
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="orderDetailModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="detail-modal-title">Chi tiết đơn hàng #...</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <p class="mb-1"><strong>Khách hàng:</strong> <span id="detail-customer">...</span></p>
                        <p class="mb-1"><strong>Thời gian đặt:</strong> <span id="detail-time">...</span></p>
                    </div>
                    <div class="col-md-6 text-md-end">
                        <p class="mb-1"><strong>Trạng thái:</strong> <span id="detail-status">...</span></p>
                        <p class="mb-1"><strong>Tổng tiền:</strong> <span class="text-primary fw-bold fs-5" id="detail-total">...</span></p>
                    </div>
                </div>

                <div class="table-responsive border rounded">
                    <table class="table table-striped mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th>Món ăn</th>
                                <th class="text-center">Số lượng</th>
                                <th class="text-end">Đơn giá</th>
                                <th class="text-end">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody id="detail-items-body">
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

    <script type="module" src="~/js/manager/pages/orders.js"></script>