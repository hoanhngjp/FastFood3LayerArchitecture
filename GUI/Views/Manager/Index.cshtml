@{
    ViewData["Title"] = "Tổng quan Nhà hàng";
    Layout = "~/Views/Shared/_LayoutManager.cshtml";
}

<div class="container-fluid px-4">

    <div class="d-flex justify-content-between align-items-center mt-4 mb-4">
        <div>
            <h2 class="fw-bold text-dark"><i class="bi bi-speedometer2 me-2"></i>Bảng điều khiển</h2>
            <p class="text-muted mb-0">Theo dõi hoạt động kinh doanh trong ngày.</p>
        </div>
        <div class="w-auto">
            <select id="restaurant-selector" class="form-select shadow-sm border-warning fw-bold">
                <option>Đang tải danh sách...</option>
            </select>
        </div>
    </div>

    <div id="dashboard-loading-area" class="text-center py-5">
        <div class="spinner-border text-warning" role="status"></div>
        <p class="mt-2 text-muted">Đang cập nhật số liệu...</p>
    </div>
    <div id="dashboard-error-area" class="alert alert-danger" style="display:none"></div>

    <div class="row g-4 mb-4">

        <div class="col-xl-4 col-md-6">
            <div class="card shadow-sm border-0 h-100 border-start border-4 border-success">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1 text-uppercase fw-bold small">Doanh thu hôm nay</p>
                            <h3 class="fw-bold text-success" id="stat-revenue">0 ₫</h3>
                        </div>
                        <div class="fs-1 text-success opacity-25">
                            <i class="bi bi-currency-dollar"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-4 col-md-6">
            <div class="card shadow-sm border-0 h-100 border-start border-4 border-warning">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1 text-uppercase fw-bold small">Đơn hàng mới</p>
                            <h3 class="fw-bold text-dark" id="stat-orders">0</h3>
                        </div>
                        <div class="fs-1 text-warning opacity-25">
                            <i class="bi bi-receipt"></i>
                        </div>
                    </div>
                    <div class="card-footer bg-white border-0 pt-0">
                        <a href="/Manager/Orders" class="small text-warning text-decoration-none fw-bold">
                            Quản lý ngay <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-4 col-md-6">
            <div class="card shadow-sm border-0 h-100 border-start border-4 border-primary">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1 text-uppercase fw-bold small">Tổng món ăn</p>
                            <h3 class="fw-bold text-primary" id="stat-foods">0</h3>
                        </div>
                        <div class="fs-1 text-primary opacity-25">
                            <i class="bi bi-egg-fried"></i>
                        </div>
                    </div>
                    <div class="card-footer bg-white border-0 pt-0">
                        <a href="/Manager/Menu" class="small text-primary text-decoration-none fw-bold">
                            Xem thực đơn <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white py-3 border-bottom">
            <h5 class="mb-0 fw-bold"><i class="bi bi-clock-history me-2"></i>Đơn hàng vừa nhận</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Mã đơn</th>
                            <th>Khách hàng</th>
                            <th>Thời gian</th>
                            <th>Tổng tiền</th>
                            <th>Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody id="recent-orders-body">
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script type="module" src="/js/manager/pages/dashboard.js"></script>
}