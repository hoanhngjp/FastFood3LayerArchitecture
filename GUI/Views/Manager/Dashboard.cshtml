@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_LayoutManager.cshtml";
}

<div class="container-fluid px-4">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mt-4 mb-4">
        <div class="mb-3 mb-md-0">
            <h2 class="fw-bold text-dark"><i class="bi bi-speedometer2 me-2"></i>Bảng điều khiển</h2>
            <p class="text-muted mb-0">Tổng quan hoạt động kinh doanh.</p>
        </div>

        <div class="card shadow-sm border-0 bg-light">
            <div class="card-body py-2 px-3">
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <span class="fw-bold text-muted small"><i class="bi bi-funnel-fill"></i> Bộ lọc:</span>

                    <select id="restaurant-selector" class="form-select form-select-sm shadow-sm border-secondary fw-bold" style="width: 200px;">
                        <option>Đang tải...</option>
                    </select>

                    <select id="time-filter" class="form-select form-select-sm shadow-sm border-primary fw-bold" style="width: 140px;">
                        <option value="today" selected>Hôm nay</option>
                        <option value="week">7 ngày qua</option>
                        <option value="month">Tháng này</option>
                        <option value="year">Năm nay</option>
                        <option value="custom">-- Tùy chọn --</option>
                    </select>

                    <div class="custom-date-range d-flex gap-1" style="display:none;">
                        <input type="date" id="date-from" class="form-control form-control-sm">
                        <span class="align-self-center">-</span>
                        <input type="date" id="date-to" class="form-control form-control-sm">
                        <button class="btn btn-sm btn-primary" id="btn-apply-date">Xem</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div id="dashboard-loading-area" class="text-center py-5">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-2 text-muted">Đang phân tích dữ liệu...</p>
    </div>
    <div id="dashboard-error-area" class="alert alert-danger shadow-sm" style="display:none">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> <span id="error-message"></span>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-xl-4 col-md-6">
            <div class="card shadow-sm border-0 h-100 border-start border-4 border-success">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1 text-uppercase fw-bold small" id="label-revenue">Doanh thu</p>
                            <h3 class="fw-bold text-success" id="stat-revenue">0 ₫</h3>
                        </div>
                        <div class="fs-1 text-success opacity-25"><i class="bi bi-currency-dollar"></i></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-4 col-md-6">
            <div class="card shadow-sm border-0 h-100 border-start border-4 border-warning">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1 text-uppercase fw-bold small">Đơn hàng</p>
                            <h3 class="fw-bold text-dark" id="stat-orders">0</h3>
                        </div>
                        <div class="fs-1 text-warning opacity-25"><i class="bi bi-receipt"></i></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-4 col-md-6">
            <div class="card shadow-sm border-0 h-100 border-start border-4 border-primary">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1 text-uppercase fw-bold small">Tổng món ăn</p>
                            <h3 class="fw-bold text-primary" id="stat-foods">0</h3>
                        </div>
                        <div class="fs-1 text-primary opacity-25"><i class="bi bi-egg-fried"></i></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-lg-8 mb-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white py-3 border-bottom">
                    <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-graph-up me-2"></i>Biểu đồ Doanh thu</h6>
                </div>
                <div class="card-body">
                    <canvas id="revenueChart" style="height: 350px;"></canvas>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white py-3 border-bottom">
                    <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-pie-chart me-2"></i>Trạng thái đơn hàng</h6>
                </div>
                <div class="card-body">
                    <div style="height: 200px; position: relative;">
                        <canvas id="statusChart"></canvas>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3 border-bottom">
                    <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-trophy me-2"></i>Top 5 Món bán chạy</h6>
                </div>
                <div class="card-body">
                    <div style="height: 200px; position: relative;">
                        <canvas id="topFoodChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-clock-history me-2"></i>Đơn hàng gần đây</h5>
            <a href="/Manager/Orders" class="btn btn-sm btn-outline-secondary">Xem tất cả</a>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Mã đơn</th>
                            <th>Khách hàng</th>
                            <th>Thời gian</th>
                            <th>Tổng tiền</th>
                            <th>Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody id="recent-orders-body">
                        <tr><td colspan="5" class="text-center text-muted py-4">Đang tải dữ liệu...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script type="module" src="~/js/manager/pages/dashboard.js"></script>
}