@{
    Layout = "_Layout";
    ViewData["Title"] = "Giỏ hàng của bạn";
}

<style>
    /* Tiêu đề Giỏ hàng và Tổng quan */
    .cart-title {
        color: #FF8800; /* Màu cam đậm */
        font-weight: bold;
        border-bottom: 2px solid #ffc107;
        padding-bottom: 15px;
        margin-bottom: 30px;
    }

    /* Khung tổng hợp */
    .cart-summary-area {
        background-color: #fff9e6; /* Nền vàng nhạt */
        padding: 20px;
        border-radius: 8px;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.05);
    }

    .summary-title {
        color: #FF8800;
        border-bottom: 1px solid #ffc107;
        padding-bottom: 10px;
        margin-bottom: 15px;
        font-weight: bold;
    }

    .summary-line {
        display: flex;
        justify-content: space-between;
        margin-bottom: 8px;
        font-size: 1.1rem;
    }

    .summary-total {
        display: flex;
        justify-content: space-between;
        margin-top: 15px;
        padding-top: 15px;
        border-top: 2px dashed #ffc107;
        font-size: 1.3rem;
        font-weight: bold;
    }

    .total-price {
        color: #E67E22; /* Màu cam đất */
    }

    .text-dark-orange {
        color: #E67E22 !important;
    }

    /* Ẩn các nút mũi tên cho input number */
    .qty-input::-webkit-outer-spin-button,
    .qty-input::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    .qty-input[type=number] {
        -moz-appearance: textfield;
    }

    /* Style cho nút disabled (bổ sung cho thẻ a) */
    a.disabled {
        pointer-events: none;
        cursor: default;
        opacity: 0.6;
    }
</style>

<div class="container my-5">

    <h2 class="cart-title">
        Giỏ hàng của bạn <span class="text-muted fs-5 fw-normal" id="cart-title-count">(0 món)</span>
    </h2>

    <div class="row g-4 cart-content-wrapper">

        <div class="col-lg-8">
            <div class="cart-items-list">
                <div class="text-center p-5 text-muted">
                    <div class="spinner-border text-warning" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <div class="mt-2">Đang tải giỏ hàng...</div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="cart-summary-area">
                <h3 class="summary-title mb-3">Tóm tắt Đơn hàng</h3>

                <div class="summary-line">
                    <span>Tổng tiền hàng (<span id="summary-total-items">0</span> món)</span>
                    <strong id="summary-subtotal">$0.00</strong>
                </div>
                <div class="summary-line">
                    <span>Phí giao hàng</span>
                    <strong id="summary-shipping-fee">$0.00</strong>
                </div>
                <div class="summary-line text-success">
                    <span><i class="bi bi-tag me-1"></i> Mã giảm giá</span>
                    <strong class="text-success" id="summary-discount">$0.00</strong>
                </div>

                <div class="summary-total">
                    <span>Tổng thanh toán</span>
                    <strong class="total-price" id="summary-grand-total">$0.00</strong>
                </div>

                <div class="d-grid gap-2 mt-4">
                    <a id="btn-checkout" href="#" class="btn btn-lg fw-bold disabled" aria-disabled="true" style="background-color: #FF8800; color: white;">
                        Giỏ hàng trống
                    </a>

                    <a href="/#food-menu" class="btn btn-outline-warning fw-bold">
                        <i class="bi bi-arrow-left me-2"></i> Tiếp tục chọn món
                    </a>
                </div>

            </div>
        </div>

    </div>

</div>

@section Scripts {
    <script type="module" src="/js/pages/cart.js"></script>
}