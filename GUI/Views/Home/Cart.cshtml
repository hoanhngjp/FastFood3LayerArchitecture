@{
    // Vì trang này là một View con, nó sẽ sử dụng Layout chính
    Layout = "_Layout";
    ViewData["Title"] = "Giỏ hàng của bạn";
}

<style>
    /* Tiêu đề Giỏ hàng và Tổng quan */
    .cart-title {
        color: #FF8800; /* Màu cam đậm */
        font-weight: bold;
        border-bottom: 2px solid #ffc107;
        padding-bottom: 15px;
        margin-bottom: 30px;
    }
    /* Khung tổng hợp */
    .cart-summary-area {
        background-color: #fff9e6; /* Nền vàng nhạt */
        padding: 20px;
        border-radius: 8px;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.05);
    }

    .summary-title {
        color: #FF8800;
        border-bottom: 1px solid #ffc107;
        padding-bottom: 10px;
        margin-bottom: 15px;
        font-weight: bold;
    }

    .summary-line {
        display: flex;
        justify-content: space-between;
        margin-bottom: 8px;
        font-size: 1.1rem;
    }

    .summary-total {
        display: flex;
        justify-content: space-between;
        margin-top: 15px;
        padding-top: 15px;
        border-top: 2px dashed #ffc107;
        font-size: 1.3rem;
        font-weight: bold;
    }

    .total-price {
        color: #E67E22; /* Màu cam đất */
    }

    /* Ẩn các nút mũi tên cho input number (như yêu cầu trước) */
    .qty-input::-webkit-outer-spin-button,
    .qty-input::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    .qty-input[type=number] {
        -moz-appearance: textfield;
    }
</style>

<div class="container my-5">

    <h2 class="cart-title">
        Giỏ hàng của bạn <span class="text-muted fs-5 fw-normal">(3 sản phẩm)</span>
    </h2>

    <div class="row g-4 cart-content-wrapper">

        <div class="col-lg-8">
            <div class="cart-items-list">

                <div class="card mb-3 shadow-sm">
                    <div class="card-body d-flex align-items-center justify-content-between p-3">
                        <div class="item-details-left d-flex align-items-center">
                            <img src="/images/food-menu-1.png" alt="Fried Chicken Unlimited" class="img-fluid me-3" style="width: 80px; height: 80px; object-fit: cover;">
                            <div class="item-info">
                                <h5 class="item-title mb-0 fw-bold">Fried Chicken Unlimited</h5>
                                <p class="item-category text-muted small mb-1">Gà</p>
                                <button class="btn btn-sm btn-outline-danger btn-remove p-0 border-0">Xóa</button>
                            </div>
                        </div>

                        <div class="item-details-right d-flex align-items-center gap-4">
                            <div class="quantity-control input-group" style="width: 120px;">
                                <button class="btn btn-outline-warning qty-btn" type="button" disabled>-</button>
                                <input type="number" value="1" min="1" class="form-control text-center qty-input" aria-label="Số lượng">
                                <button class="btn btn-outline-warning qty-btn" type="button">+</button>
                            </div>
                            <div class="item-price" style="width: 100px; text-align: right;">
                                <data class="price-current fw-bold text-danger fs-5" value="49.00">$49.00</data>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card mb-3 shadow-sm">
                    <div class="card-body d-flex align-items-center justify-content-between p-3">
                        <div class="item-details-left d-flex align-items-center">
                            <img src="/images/food-menu-2.png" alt="Burger King Whopper" class="img-fluid me-3" style="width: 80px; height: 80px; object-fit: cover;">
                            <div class="item-info">
                                <h5 class="item-title mb-0 fw-bold">Burger King Whopper</h5>
                                <p class="item-category text-muted small mb-1">Mì</p>
                                <button class="btn btn-sm btn-outline-danger btn-remove p-0 border-0">Xóa</button>
                            </div>
                        </div>

                        <div class="item-details-right d-flex align-items-center gap-4">
                            <div class="quantity-control input-group" style="width: 120px;">
                                <button class="btn btn-outline-warning qty-btn" type="button">-</button>
                                <input type="number" value="2" min="1" class="form-control text-center qty-input" aria-label="Số lượng">
                                <button class="btn btn-outline-warning qty-btn" type="button">+</button>
                            </div>
                            <div class="item-price" style="width: 100px; text-align: right;">
                                <data class="price-current fw-bold text-danger fs-5" value="58.00">$58.00</data>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card mb-3 shadow-sm">
                    <div class="card-body d-flex align-items-center justify-content-between p-3">
                        <div class="item-details-left d-flex align-items-center">
                            <img src="/images/food-menu-3.png" alt="White Castle Pizzas" class="img-fluid me-3" style="width: 80px; height: 80px; object-fit: cover;">
                            <div class="item-info">
                                <h5 class="item-title mb-0 fw-bold">White Castle Pizzas</h5>
                                <p class="item-category text-muted small mb-1">Pizza</p>
                                <button class="btn btn-sm btn-outline-danger btn-remove p-0 border-0">Xóa</button>
                            </div>
                        </div>

                        <div class="item-details-right d-flex align-items-center gap-4">
                            <div class="quantity-control input-group" style="width: 120px;">
                                <button class="btn btn-outline-warning qty-btn" type="button">-</button>
                                <input type="number" value="1" min="1" class="form-control text-center qty-input" aria-label="Số lượng">
                                <button class="btn btn-outline-warning qty-btn" type="button">+</button>
                            </div>
                            <div class="item-price" style="width: 100px; text-align: right;">
                                <data class="price-current fw-bold text-danger fs-5" value="49.00">$49.00</data>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <div class="col-lg-4">
            <div class="cart-summary-area">
                <h3 class="summary-title mb-3">Tóm tắt Đơn hàng</h3>

                <div class="summary-line">
                    <span>Tổng tiền hàng (3 món)</span>
                    <strong>$156.00</strong>
                </div>
                <div class="summary-line">
                    <span>Phí giao hàng</span>
                    <strong>$5.00</strong>
                </div>
                <div class="summary-line text-success">
                    <span><i class="bi bi-tag me-1"></i> Mã giảm giá</span>
                    <strong class="text-success">-$10.00</strong>
                </div>

                <div class="summary-total">
                    <span>Tổng thanh toán</span>
                    <strong class="total-price">$151.00</strong>
                </div>

                <div class="d-grid gap-2 mt-4">
                    <a href="/Checkout" class="btn btn-lg fw-bold" style="background-color: #FF8800; color: white;">
                        <i class="bi bi-cart-check me-2"></i> Tiến hành Thanh toán
                    </a>
                    <a href="/#food-menu" class="btn btn-outline-warning fw-bold">
                        <i class="bi bi-arrow-left me-2"></i> Tiếp tục chọn món
                    </a>
                </div>

            </div>
        </div>

    </div>

</div>