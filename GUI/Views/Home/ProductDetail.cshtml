@{
    Layout = "_Layout";
    ViewData["Title"] = "Chi tiết sản phẩm";
}

<style>
    /* Màu cam đậm cho tiêu đề chính */
    .text-dark-orange { color: #FF8800 !important; }

    /* Ghi đè màu đỏ cho icon rating để dùng màu cam/vàng */
    .rating-wrapper i.bi-star-fill { color: #FFC107; }

    /* Giá cũ dùng màu xám */
    .price-old { color: #6c757d; }

    /* Các nút và badge sẽ dùng màu warning/cam */
    .badge-discount {
        background-color: #FF8800 !important;
        color: white;
        position: absolute;
        top: 0;
        right: 0;
        transform: translate(25%, -25%);
        font-size: 0.9rem;
        padding: 0.5em 0.8em;
        z-index: 10;
    }

    /* === ĐIỀU CHỈNH KÍCH THƯỚC VÀ KHUNG ẢNH === */
    .product-image-area {
        position: relative;
        background-color: white;
        border-radius: 8px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 15px;
        max-width: 350px;
        height: auto;
        aspect-ratio: 1 / 1;
        margin: 0 auto;
    }

    .product-main-image {
        width: 100%;
        height: 100%;
        object-fit: contain;
    }

    /* Ẩn mũi tên input number */
    .qty-input::-webkit-outer-spin-button,
    .qty-input::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }
    .qty-input[type=number] { -moz-appearance: textfield; }
</style>

<div class="container my-5">

    <div class="row mb-4">
        <div class="col">
            <h1 class="text-dark-orange fw-bolder"><i class="bi bi-basket-fill me-2"></i> Chi tiết món ăn</h1>
        </div>
    </div>

    <div id="loading-message" class="text-center p-5" style="display: block;">
        <p class="fs-4">Đang tải chi tiết món ăn...</p>
        <div class="spinner-border text-dark-orange" role="status"></div>
    </div>

    <div id="error-message" class="alert alert-danger" style="display: none;"></div>

    <div class="row g-5 product-detail-container" id="product-detail-content" style="display: none;">

        <div class="col-lg-5">
            <div class="product-image-area">
                <img src="/images/food-menu-default.png" id="product-image" alt="Món ăn" class="product-main-image">
                
                <span class="badge badge-discount" id="discount-badge" style="display: none;"></span>
            </div>
        </div>

        <div class="col-lg-7 product-info-area">

            <p class="text-muted text-uppercase fw-bold mb-1" id="product-category"></p>

            <h1 class="h2 section-title product-title fw-bold text-dark-orange" id="product-title"></h1>

            <div class="rating-wrapper detail-rating mb-3 fs-5" id="product-rating">
                </div>
            <span class="text-muted ms-2 fs-6" id="review-count"></span>

            <div class="price-wrapper detail-price mb-4">
                <data class="price-current fw-bolder text-danger fs-1" id="price-current"></data>
                
                <del class="price-old text-muted ms-3 fs-4" id="price-old" style="display: none;"></del>

                <p class="price-text mt-2 text-dark-orange fw-bold" id="price-saved"></p>
            </div>

            <p class="product-description text-secondary mb-4" id="product-description"></p>

            <p class="availability fs-5">Tình trạng: <strong class="text-success">Còn hàng</strong></p>

            <hr>

            <div class="cart-action-group d-flex align-items-center gap-3">
                <div class="quantity-control input-group" style="width: 150px;">
                    <button class="btn btn-outline-warning qty-btn" type="button" id="button-addon1">-</button>
                    <input type="number" value="1" min="1" class="form-control text-center qty-input" aria-label="Số lượng">
                    <button class="btn btn-outline-warning qty-btn" type="button" id="button-addon2">+</button>
                </div>

                <button id="add-to-cart-btn" class="btn btn-warning btn-lg add-to-cart-btn text-dark fw-bold flex-grow-1" style="max-width: 300px;">
                    <i class="bi bi-cart-plus me-2"></i> Thêm vào giỏ hàng
                </button>
            </div>

            <hr>

            <a href="/#food-menu" class="btn btn-outline-secondary btn-sm mt-3">
                <i class="bi bi-arrow-left me-2"></i> Tiếp tục chọn món
            </a>

        </div>
    </div>
</div>

<script>
    @{
        // Logic lấy ID giữ nguyên
        var foodIdFromQuery = Context.Request.Query["foodId"];
        var foodIdFromRoute = ViewContext.RouteData.Values["id"];
        var finalFoodId = !string.IsNullOrEmpty(foodIdFromQuery) ? foodIdFromQuery : foodIdFromRoute;
    }
    window.foodId = '@(finalFoodId)';
</script>

@section Scripts {
    <script type="module" src="/js/services/foodService.js"></script>
    <script type="module" src="/js/services/productDetail.js"></script>
    <script type="module" src="/js/services/cartService.js"></script>
}