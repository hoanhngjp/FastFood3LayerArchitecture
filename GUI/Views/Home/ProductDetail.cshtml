
@{
    Layout = "_Layout";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chi tiết sản phẩm | Fried Chicken Unlimited</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/product-detail.css">
    <link rel="stylesheet" href="/css/cart.css">
</head>
<body>

    <section class="section product-detail-section">
        <div class="container product-detail-container">

            <div class="product-image-area">
                <img src="/images/food-menu-1.png" alt="Fried Chicken Unlimited" class="product-main-image">
                <div class="badge product-badge">-15%</div>
            </div>

            <div class="product-info-area">
                <p class="section-subtitle product-category">Chicken</p>
                <h1 class="h1 section-title product-title">Fried Chicken Unlimited</h1>

                <div class="rating-wrapper detail-rating">
                    <ion-icon name="star"></ion-icon>
                    <ion-icon name="star"></ion-icon>
                    <ion-icon name="star"></ion-icon>
                    <ion-icon name="star"></ion-icon>
                    <ion-icon name="star"></ion-icon>
                    <span class="rating-count">(150 Reviews)</span>
                </div>

                <div class="price-wrapper detail-price">
                    <data class="price-current" value="49.00">$49.00</data>
                    <del class="price-old">$69.00</del>
                    <p class="price-text">Tiết kiệm: $20.00</p>
                </div>

                <p class="product-description">
                    Gà rán giòn rụm với công thức ướp đặc biệt, chiên ngập dầu cho lớp vỏ ngoài vàng óng. Phù hợp cho bữa ăn gia đình hoặc tiệc tùng.
                </p>

                <p class="availability">Tình trạng: <strong>Còn hàng</strong></p>

                <div class="cart-action-group">
                    <div class="quantity-control">
                        <button class="qty-btn">-</button>
                        <input type="text" value="1" min="1" class="qty-input">
                        <button class="qty-btn">+</button>
                    </div>

                    <button class="btn add-to-cart-btn">
                        Thêm vào giỏ hàng
                    </button>

                </div>

                <a href="/#food-menu" class="btn btn-continue">
                    Tiếp tục chọn món
                </a>
             
            </div>

        </div>
    </section>

</body>
</html>