@{
    ViewData["Title"] = "Lịch sử Giao dịch";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex gap-2">
        <div class="input-group" style="width: 300px;">
            <span class="input-group-text bg-white border-end-0"><i class="bi bi-search"></i></span>
            <input type="text" id="searchKeyword" class="form-control border-start-0 ps-0" placeholder="Tìm Mã GD, Mã đơn...">
        </div>

        <select id="filterStatus" class="form-select" style="width: 150px;">
            <option value="">-- Trạng thái --</option>
            <option value="1">Success</option>
            <option value="2">Failed</option>
        </select>

        <select id="pageSizeSelect" class="form-select" style="width: 120px;">
            <option value="10">10 dòng</option>
            <option value="20">20 dòng</option>
            <option value="50">50 dòng</option>
        </select>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th class="ps-4">Mã GD (VNPay)</th>
                    <th>Đơn hàng</th>
                    <th>Số tiền</th>
                    <th>Ngân hàng</th>
                    <th>Thời gian</th>
                    <th>Trạng thái</th>
                </tr>
            </thead>
            <tbody id="paymentTableBody"></tbody>
        </table>
    </div>
    <div class="card-footer bg-white py-3">
        <nav><ul class="pagination pagination-sm mb-0 justify-content-end" id="paginationControls"></ul></nav>
    </div>
</div>

@section Scripts {
    <script type="module" src="~/js/admin/pages/payment.js"></script>
}