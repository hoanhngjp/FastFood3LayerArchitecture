@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Reports";
}

<h2 class="mb-4">📊 Báo cáo & Thống kê</h2>

<div class="row g-4">
    <div class="col-lg-12">
        <div class="card shadow-sm">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0">Biểu đồ Doanh thu theo tháng</h5>
            </div>
            <div class="card-body text-center py-5">
                <p class="text-muted">**(Nơi tích hợp biểu đồ Chart.js hoặc thư viện khác)**</p>
                <div style="height: 300px; background-color: #f8f8f8; border-radius: 5px;">
                    <em class="text-secondary small d-flex align-items-center justify-content-center h-100">Dữ liệu biểu đồ sẽ được tải ở đây</em>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card shadow-sm">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0">Top 5 Món ăn bán chạy nhất</h5>
            </div>
            <div class="card-body">
                <ul class="list-group list-group-flush">
                    <li class="list-group-item d-flex justify-content-between">Pizza <span class="badge bg-warning">200 đơn</span></li>
                    <li class="list-group-item d-flex justify-content-between">Hamburger <span class="badge bg-warning">150 đơn</span></li>
                    <li class="list-group-item d-flex justify-content-between">Spaghetti <span class="badge bg-warning">100 đơn</span></li>
                </ul>
            </div>
        </div>
    </div>
</div>