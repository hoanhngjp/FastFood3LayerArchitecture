@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Menu";
}

<h2 class="mb-4">🍔 Quản lý Thực đơn</h2>

<div class="card shadow-sm">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Danh sách Món ăn (<span id="menu-count">0</span> món)</h5>
        <button class="btn btn-warning text-dark fw-bold" data-bs-toggle="modal" data-bs-target="#addMenuItemModal">
            <i class="bi bi-plus-circle me-2"></i> Thêm món mới
        </button>
    </div>
    <div class="card-body">

        <div class="row mb-4">
            <div class="col-md-6">
                <div class="input-group">
                    <input type="text" class="form-control" placeholder="Tìm kiếm theo tên món, mã món..." id="search-food-input">
                    <button class="btn btn-outline-secondary" type="button" id="search-food-button"><i class="bi bi-search"></i></button>
                </div>
            </div>
            <div class="col-md-6 d-flex justify-content-end gap-2">
                <select class="form-select w-auto" id="category-filter-select">
                    <option value="" selected>Lọc: Tất cả Danh mục</option>
                </select>
                <select class="form-select w-auto" id="status-filter-select">
                    <option value="" selected>Lọc: Tất cả Trạng thái</option>
                    <option value="true">Đang bán</option>
                    <option value="false">Ngừng bán</option>
                </select>
            </div>
        </div>

        <p class="text-muted small">Quản lý giá, danh mục, và trạng thái của các món ăn.</p>

        <div id="food-loading-area" class="text-center p-5">
            <div class="spinner-border text-warning me-2" role="status"></div>
            <p class="mt-2 text-muted">Đang tải dữ liệu thực đơn...</p>
        </div>
        <div id="food-error-message-area" class="alert alert-danger" style="display: none;"></div>

        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th style="width: 50px;">Ảnh</th>
                        <th>Tên Món ăn</th>
                        <th>Giá (VND)</th>
                        <th>Danh mục</th>
                        <th>Trạng thái</th>
                        <th>Hành động</th>
                    </tr>
                </thead>
                <tbody id="foods-table-body">
                </tbody>
            </table>
        </div>

        <nav aria-label="Phân trang danh sách món ăn" class="mt-4">
            <ul class="pagination justify-content-center" id="food-pagination">
            </ul>
        </nav>
    </div>
</div>

<div class="modal fade" id="addMenuItemModal" tabindex="-1" aria-labelledby="addMenuItemModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title" id="addMenuItemModalLabel">Thêm Món ăn mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="add-food-form">
                    <div class="mb-3">
                        <label for="item-name" class="form-label">Tên Món ăn (*)</label>
                        <input type="text" class="form-control" id="item-name" required>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="item-price" class="form-label">Giá bán (*)</label>
                            <input type="number" class="form-control" id="item-price" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="item-category" class="form-label">Danh mục (*)</label>
                            <select class="form-select" id="item-category" required>
                                <option value="" selected>Chọn danh mục</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="item-description" class="form-label">Mô tả chi tiết</label>
                        <textarea class="form-control" id="item-description" rows="3"></textarea>
                    </div>
                    <div class="mb-3">
                        <label for="item-image" class="form-label">Hình ảnh Món ăn</label>
                        <input class="form-control" type="file" id="item-image">
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="item-status" checked>
                        <label class="form-check-label" for="item-status">Đang bán</label>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="submit" form="add-food-form" class="btn btn-warning text-dark">Lưu Món ăn</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="editMenuItemModal" tabindex="-1" aria-labelledby="editMenuItemModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="editMenuItemModalLabel">Chỉnh sửa Món ăn</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Nội dung form chỉnh sửa sẽ được JS tải vào đây.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary">Lưu Thay đổi</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteMenuItemModal" tabindex="-1" aria-labelledby="deleteMenuItemModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteMenuItemModalLabel">Xác nhận Xóa</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Bạn có chắc chắn muốn xóa món **<span id="food-to-delete-name"></span>** không?</p>
                <input type="hidden" id="food-to-delete-id">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy bỏ</button>
                <button type="button" class="btn btn-danger" id="confirm-delete-food">Xóa Món ăn</button>
            </div>
        </div>
    </div>
</div>

<script type="module" src="/js/authChecker.js"></script>
<script type="module" src="/js/categoryService.js"></script>
<script type="module" src="/js/foodService.js"></script>
<script type="module" src="/js/loadMenu.js"></script>