@{
    ViewData["Title"] = "Tổng quan hệ thống";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-center mt-4 mb-4">
    <div class="mb-3 mb-md-0">
        <h2 class="fw-bold text-dark mb-0">Dashboard Tổng Quan</h2>
        <div class="text-muted small">Dữ liệu cập nhật thời gian thực</div>
    </div>

    <div class="card shadow-sm border-0 bg-light">
        <div class="card-body py-2 px-3">
            <div class="d-flex flex-wrap align-items-center gap-2">
                <span class="fw-bold text-muted small"><i class="bi bi-funnel-fill"></i> Bộ lọc:</span>

                <select id="admin-res-selector" class="form-select form-select-sm shadow-sm border-secondary fw-bold" style="width: 220px;">
                    <option value="0">-- Tất cả hệ thống --</option>
                    <option disabled>Đang tải...</option>
                </select>

                <select id="time-filter" class="form-select form-select-sm shadow-sm border-primary fw-bold" style="width: 140px;">
                    <option value="today" selected>Hôm nay</option>
                    <option value="week">7 ngày qua</option>
                    <option value="month">Tháng này</option>
                    <option value="year">Năm nay</option>
                    <option value="custom">-- Tùy chọn --</option>
                </select>

                <div class="custom-date-range d-flex gap-1" style="display:none;">
                    <input type="date" id="date-from" class="form-control form-control-sm">
                    <span class="align-self-center">-</span>
                    <input type="date" id="date-to" class="form-control form-control-sm">
                    <button class="btn btn-sm btn-primary" id="btn-apply-date">Xem</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="row g-4 mb-4">
    <div class="col-xl-3 col-md-6">
        <div class="card shadow-sm border-0 border-start border-4 border-primary h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <p class="text-uppercase text-muted small fw-bold mb-1">Tổng Doanh Thu</p>
                        <h4 class="fw-bold text-primary" id="sys-revenue">0 ₫</h4>
                    </div>
                    <div class="fs-1 text-primary opacity-25"><i class="bi bi-wallet2"></i></div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="card shadow-sm border-0 border-start border-4 border-success h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <p class="text-uppercase text-muted small fw-bold mb-1">Tổng Đơn Hàng</p>
                        <h4 class="fw-bold text-success" id="sys-orders">0</h4>
                    </div>
                    <div class="fs-1 text-success opacity-25"><i class="bi bi-cart-check"></i></div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="card shadow-sm border-0 border-start border-4 border-info h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <p class="text-uppercase text-muted small fw-bold mb-1">Người dùng</p>
                        <h4 class="fw-bold text-info" id="sys-users">0</h4>
                    </div>
                    <div class="fs-1 text-info opacity-25"><i class="bi bi-people"></i></div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="card shadow-sm border-0 border-start border-4 border-warning h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <p class="text-uppercase text-muted small fw-bold mb-1">Drone Hoạt Động</p>
                        <h4 class="fw-bold text-warning" id="sys-drones">0/0</h4>
                    </div>
                    <div class="fs-1 text-warning opacity-25"><i class="bi bi-airplane"></i></div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col-lg-8 mb-4 mb-lg-0">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3">
                <h6 class="mb-0 fw-bold"><i class="bi bi-graph-up-arrow me-2"></i>Xu hướng Doanh thu (30 ngày)</h6>
            </div>
            <div class="card-body">
                <canvas id="adminRevenueChart" style="max-height: 350px;"></canvas>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3">
                <h6 class="mb-0 fw-bold"><i class="bi bi-trophy-fill me-2"></i>Top Nhà Hàng</h6>
            </div>
            <div class="card-body">
                <div style="height: 300px; position: relative;">
                    <canvas id="topResChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <h6 class="mb-0 fw-bold"><i class="bi bi-activity me-2"></i>Giao dịch mới nhất hệ thống</h6>
        <button class="btn btn-sm btn-outline-secondary" onclick="location.reload()"><i class="bi bi-arrow-clockwise"></i></button>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Mã đơn</th>
                    <th>Nhà hàng</th>
                    <th>Khách hàng</th>
                    <th>Thời gian</th>
                    <th>Giá trị</th>
                    <th>Trạng thái</th>
                </tr>
            </thead>
            <tbody id="system-recent-orders">
                <tr><td colspan="6" class="text-center py-4 text-muted">Đang tải dữ liệu...</td></tr>
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script type="module" src="~/js/admin/pages/dashboard.js"></script>
}