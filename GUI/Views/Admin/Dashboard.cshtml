@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Dashboard";
}

<div id="dashboard-alert-area">
    <div class="alert alert-success alert-dismissible fade show" role="alert"
         style="position: fixed; top: 20px; right: 20px; z-index: 1050; min-width: 250px;">
        Đăng nhập thành công!
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
</div>

<h2 class="mb-4">Dashboard - Foodie</h2>

<div id="dashboard-loading-area" class="text-center p-5" style="display: none;">
    <div class="spinner-border text-primary me-2" role="status"></div>
    <p class="mt-2 text-muted">Đang tải dữ liệu Dashboard...</p>
</div>
<div id="dashboard-error-area" class="alert alert-danger" style="display: none;"></div>

<div class="row g-4 mb-4">
    <div class="col-md-6 col-lg-4">
        <div class="card stat-card text-white" style="background-color: #e67e22;">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h3 class="fw-bold mb-1" id="orders-today-count">--</h3>
                    <span class="small">Đơn hàng hôm nay</span>
                </div>
                <i class="bi bi-bag-fill fs-2 opacity-75"></i>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-4">
        <div class="card stat-card text-white" style="background-color: #fd7e14;">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h3 class="fw-bold mb-1" id="revenue-today-amount">--</h3>
                    <span class="small">Doanh thu hôm nay</span>
                </div>
                <i class="bi bi-currency-dollar fs-2 opacity-75"></i>
            </div>
        </div>
    </div>

    <div class="col-md-12 col-lg-4">
        <div class="card stat-card text-white" style="background-color: #f39c12;">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h3 class="fw-bold mb-1" id="active-foods-count">--</h3>
                    <span class="small">Món ăn đang bán</span>
                </div>
                <i class="bi bi-cup-straw fs-2 opacity-75"></i>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="mb-0">📋 Chi tiết Đơn hàng gần nhất</h5>
                <a href="/Admin/Orders" class="btn btn-sm btn-outline-warning">Xem tất cả</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th>Mã đơn</th>
                                <th>Khách hàng</th>
                                <th>Thời gian</th>
                                <th>Tổng tiền</th>
                                <th>Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody id="recent-orders-body">

                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer bg-light text-center text-muted small py-2">
                Dữ liệu thời gian thực.
            </div>
        </div>
    </div>

    <div class="col-lg-4">

    </div>
</div>

<script type="module" src="/js/services/orderService.js"></script>
<script type="module" src="/js/services/foodService.js"></script>
<script type="module" src="/js/pages/adminDashboard.js"></script>