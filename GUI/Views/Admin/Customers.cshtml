@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Customers";
}

<h2 class="mb-4">👤 Quản lý Khách hàng</h2>

<div class="card shadow-sm">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Danh sách Khách hàng (<span id="customer-count">Đang tải...</span>)</h5>
        <button class="btn btn-warning text-dark fw-bold" data-bs-toggle="modal" data-bs-target="#addCustomerModal">
            <i class="bi bi-person-plus-fill me-2"></i> Thêm Khách hàng mới
        </button>
    </div>
    <div class="card-body">

        <div id="loading-area-customer" class="text-center p-5" style="display: none;">
            <div class="spinner-border text-primary me-2" role="status"></div>
            <p class="mt-2 text-muted">Đang tải danh sách khách hàng...</p>
        </div>
        <div id="error-message-area-customer" class="alert alert-danger" style="display: none;"></div>

        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Tên Khách hàng</th>
                        <th>Email</th>
                        <th>Số điện thoại</th>
                        <th>Tổng đơn</th>
                        <th>Điểm tích lũy</th>
                        <th>Hành động</th>
                    </tr>
                </thead>
                <tbody id="customers-table-body">

                </tbody>
            </table>
        </div>

        <nav aria-label="Phân trang danh sách khách hàng" class="mt-4">
            <ul class="pagination justify-content-center">
                <li class="page-item disabled"><a class="page-link" href="#">Trước</a></li>
                <li class="page-item active"><a class="page-link" href="#">1</a></li>
                <li class="page-item"><a class="page-link" href="#">2</a></li>
                <li class="page-item"><a class="page-link" href="#">3</a></li>
                <li class="page-item"><a class="page-link" href="#">Tiếp</a></li>
            </ul>
        </nav>
    </div>
</div>


<script type="module" src="/js/services/userService.js"></script>
<script type="module" src="/js/pages/adminCustomer.js"></script>