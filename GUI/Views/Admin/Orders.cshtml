                <td><button class="btn btn-sm btn-outline-primary">Chi tiết</button></td>
            </tr>
            <tr>
                <td>#DH002</td>
                <td>Trần Thị B</td>
                <td>2025-11-10</td>
                <td>₫150,000</td>
                <td><span class="badge bg-warning text-dark">Đang xử lý</span></td>
                <td><button class="btn btn-sm btn-outline-primary">Chi tiết</button></td>
            </tr>
        </tbody>
    </table>
</div>
