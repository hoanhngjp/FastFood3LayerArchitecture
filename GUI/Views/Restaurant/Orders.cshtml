@{
    ViewData["Title"] = "Danh sách Đơn hàng";
    Layout = "_RestaurantLayout";
}

<div class="restaurant-orders">
    <div class="admin-header">
        <h2>📋 Quản lý Đơn hàng</h2>
        <select class="form-control status-filter">
            <option>Tất cả Trạng thái</option>
            <option value="new">Đơn hàng Mới</option>
            <option value="processing">Đang Chế biến</option>
            <option value="ready">Sẵn sàng Giao</option>
        </select>
    </div>

    <div class="order-table-wrapper">
        <table class="data-table order-table">
            <thead>
                <tr>
                    <th>Mã Đơn</th>
                    <th>Thời gian Đặt</th>
                    <th>Khách hàng</th>
                    <th>Tổng tiền</th>
                    <th>Trạng thái</th>
                    <th>Hành động</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>#20250012</td>
                    <td>15:55 PM</td>
                    <td>Nguyễn Văn A</td>
                    <td>$49.00</td>
                    <td><span class="status-badge status-new">Mới</span></td>
                    <td>
                        <a asp-action="OrderDetail" asp-route-id="12" class="btn btn-sm btn-info">Chi tiết</a>
                    </td>
                </tr>
                <tr>
                    <td>#20250011</td>
                    <td>15:40 PM</td>
                    <td>Lê Thị B</td>
                    <td>$108.00</td>
                    <td><span class="status-badge status-processing">Đang chế biến</span></td>
                    <td>
                        <a asp-action="OrderDetail" asp-route-id="11" class="btn btn-sm btn-info">Chi tiết</a>
                    </td>
                </tr>
                <tr>
                    <td>#20250010</td>
                    <td>15:20 PM</td>
                    <td>Phạm Văn C</td>
                    <td>$35.70</td>
                    <td><span class="status-badge status-ready">Sẵn sàng giao</span></td>
                    <td>
                        <a asp-action="OrderDetail" asp-route-id="10" class="btn btn-sm btn-success">Hoàn thành</a>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
